{
  "plugin": 1,
  "version": "1.0.0",
  "entry": "index.ts",
  "template": {
    "schema": 1,
    "id": "claude-deepseek",
    "label": "Claude Code (DeepSeek)",
    "description": "Claude Code through DeepSeek’s Anthropic-compatible API. Only the key is yours.",
    "agent": "claude",
    "model": null,
    "env": {
      "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
      "ANTHROPIC_MODEL": "deepseek-chat",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-chat",
      "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "128000"
    },
    "home": {
      "env": "CLAUDE_CONFIG_DIR"
    },
    "fields": [],
    "apiKey": {
      "env": "ANTHROPIC_AUTH_TOKEN",
      "label": "DeepSeek API key",
      "required": true
    },
    "install": "claude"
  },
  "authMethods": [
    {
      "id": "key",
      "label": "API key",
      "flow": "key",
      "description": "Paste your API key; it stays in this profile’s private key file."
    }
  ],
  "order": 2,
  "machine": false,
  "tests": ["**/*.test.ts"],
  "features": {
    "modes": ["default", "acceptEdits", "auto", "dontAsk", "plan", "bypassPermissions"],
    "efforts": ["low", "medium", "high", "xhigh", "max"],
    "compaction": "message",
    "autoCompactThreshold": true,
    "cacheIdleRiskMs": null
  }
}
