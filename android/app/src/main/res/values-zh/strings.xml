    <string name="section_phone">手机访问</string>
    <string name="setting_phone">允许智能体使用此手机</string>
    <string name="setting_phone_hint">默认关闭。允许 deck 中的 AI 智能体读取电量和设备信息，并向此手机发送通知。停止 → 启动后生效。</string>
    <string name="phone_warn_title">手机访问：请先阅读</string>
    <string name="phone_warn_body">deck 中的 AI 智能体将能读取此手机的信息（电量、设备）并显示通知，以后可能增加更多能力。智能体可能被网页、文件或消息中的文字欺骗（提示注入）而滥用其可触及的内容。仅在你理解并确实需要时开启。</string>
    <string name="phone_continue">我已了解，继续</string>
    <string name="phone_confirm_title">确定吗？</string>
    <string name="phone_confirm_body">你可以随时在此关闭。智能体只能获得此开关允许的内容，且每个请求都会写入日志。启用手机访问？</string>
    <string name="phone_enable">启用</string>
    <string name="phone_notif_off">此应用的通知已关闭。请在打开的页面中开启。</string>
    <string name="phone_channel">智能体通知</string>
    <string name="setting_phone_files">文件</string>
    <string name="files_off">关闭</string>
    <string name="files_shared">仅共享文件夹</string>
    <string name="files_all">全部存储</string>
    <string name="setting_phone_files_hint">共享文件夹：智能体只能看到手机上的“CLI Deck”文件夹，在终端中位于 /root/phone。全部存储：整个内部存储，位于 /sdcard。停止 → 启动后生效。</string>
    <string name="phone_files_warn_title">文件访问</string>
    <string name="phone_files_shared_body">智能体将能读取并修改手机上“CLI Deck”文件夹内的所有内容（位于 /root/phone），除此之外什么都不行。只放你愿意让它们看到的内容。Android 会请求存储权限。继续？</string>
    <string name="phone_files_all_body">智能体将能读取、修改并删除存储中的任何文件：照片、文档、下载、其他应用的文件。被欺骗的智能体可能泄露或毁坏它们。建议选择“仅共享文件夹”。Android 会请求存储权限。确定使用全部存储？</string>
    <string name="phone_permission_denied">未授予权限：该功能保持关闭。</string>
    <string name="phone_files_allfiles">请在打开的页面中为此应用开启“允许访问所有文件”。</string>
    <string name="phone_confirm_channel">智能体的请求</string>
    <string name="phone_allow">允许</string>
    <string name="phone_deny">拒绝</string>
    <string name="phone_ask_connect">有智能体想让此手机连接 Wi-Fi 网络“%1$s”。</string>
    <string name="phone_ask_wifi_on">有智能体想打开 Wi-Fi。</string>
    <string name="phone_ask_wifi_off">有智能体想关闭 Wi-Fi。</string>
    <string name="risk_low">低风险</string>
    <string name="risk_medium">中风险</string>
    <string name="risk_high">高风险</string>
    <string name="phone_cap_title_low">低风险</string>
    <string name="phone_cap_title_medium">中风险</string>
    <string name="phone_cap_title_high">高风险</string>
    <string name="phone_cap_body_low">这会让智能体在手机上做一些无害但可察觉的事。Android 可能会请求权限。</string>
    <string name="phone_cap_body_medium">这会触及个人信息或你周围的环境（位置、网络、相机、麦克风）。智能体可能被网页或文件中的文字欺骗（提示注入）而使用它，且它们读到的内容会发送给 AI 提供商。仅在你接受时开启。</string>
    <string name="phone_cap_body_high">这会触及你的隐私数据，或让智能体以你的名义行事或花钱（联系人、短信、通话、日历）。被欺骗的智能体可能泄露或滥用。每次使用都会等待你点按“允许”，但请仔细阅读每个请求。仅在确实需要时开启。</string>
    <string name="phone_special_page">请在打开的页面中为此应用开启“修改系统设置”。</string>
